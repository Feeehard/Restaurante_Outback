<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cardápio</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <header>
        <h1>Meu Restaurante</h1>

        <nav>
            <a href="/">Home</a>
            <a href="/cardapio">Cardápio</a>
        </nav>
    </header>

    <main>
        <h2>Nosso Cardápio</h2>

        <div class="cardapio">

            <div class="card">
                <h3>Hambúrguer</h3>
                <p>Hambúrguer artesanal com queijo e salada.</p>
                <strong>R$ 25,00</strong>
            </div>

            <div class="card">
                <h3>Pizza</h3>
                <p>Pizza de queijo com molho de tomate.</p>
                <strong>R$ 40,00</strong>
            </div>

            <div class="card">
                <h3>Batata Frita</h3>
                <p>Porção de batatas fritas crocantes.</p>
                <strong>R$ 15,00</strong>
            </div>

        </div>
    </main>

</body>
</html>